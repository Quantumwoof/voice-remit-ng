# Copy to .env and fill in. Never commit .env.

# Demo mode: mock STT + remittance tools (no API key needed)
DEMO_MODE=1

# Live mode: set DEMO_MODE=0 and provide your AssemblyAI key
# Get a key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Optional: streaming speech model (default: universal-streaming-multilingual for NG accents)
# ASSEMBLYAI_SPEECH_MODEL=universal-streaming-multilingual
